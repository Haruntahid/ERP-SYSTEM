# Base domain used to read the school from the subdomain (school1.example.com). Leave empty in development.
VITE_BASE_DOMAIN=
# Development only: school slug sent as X-Tenant-ID when no subdomain is used.
VITE_TENANT_ID=
# API origin. Leave empty to use the Vite dev proxy (/api -> http://localhost:8080).
VITE_API_URL=
